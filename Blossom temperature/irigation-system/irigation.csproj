    <RootNamespace>irigation_system</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Controllers\SensorController.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="irrigation.db" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0" />
